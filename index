ejoin=\"round\"><path d=\"M4 9v6h4l5 4V5L8 9z\"><\u002Fpath><path d=\"M16.5 8.5a5 5 0 0 1 0 7\"><\u002Fpath><\u002Fsvg>\nVoz\n<\u002Fbutton>\n<button class=\"tog \" type=\"button\">\n<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"><\u002Frect><path d=\"M7 13h4M13 13h4M7 16h10\"><\u002Fpath><\u002Fsvg>\nSubtítulos\n<\u002Fbutton>\n<\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if><\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;accent&quot;:{&quot;editor&quot;:&quot;color&quot;,&quot;default&quot;:&quot;#FF5A3C&quot;,&quot;options&quot;:[&quot;#FF5A3C&quot;,&quot;#4DA3FF&quot;,&quot;#B57BFF&quot;,&quot;#2EC4A0&quot;]},&quot;rate&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:1.12,&quot;min&quot;:0.8,&quot;max&quot;:1.3,&quot;step&quot;:0.02,&quot;section&quot;:&quot;Voz&quot;},&quot;$preview&quot;:{&quot;width&quot;:1280,&quot;height&quot;:800}}\">\nclass Component extends DCLogic {\n  constructor(...args) {\n    super(...args);\n    this.state = { t: 0, playing: false, started: false, ended: false, voice: true, subs: true };\n    this.speaking = false;\n    this.hold = 0;\n    this.tok = 0;\n  }\n\n  D() {\n    if (this._d) return this._d;\n    const scenes = [\n      { name: 'Diciembre de 1923' }, { name: 'IES Goya' }, { name: 'Fairén Gallán' },\n      { name: 'Robert Bárány' }, { name: 'Lorente de Nó' }, { name: 'Upsala' },\n      { name: 'El legado' }, { name: '¿Y el Nobel?' }, { name: 'Final' }\n    ];\n    const cues = [\n      { s: 0, text: 'Diciembre de 1923. Un tren llega a Zaragoza. Dentro viaja un Premio Nobel.' },\n      { s: 0, text: '¿Qué hace aquí? Para entenderlo, hay que rebobinar… hasta un instituto.' },\n      { s: 1, text: 'Zaragoza. IES Goya. Un instituto público de toda la vida.', say: 'Zaragoza. Instituto Goya. Un instituto público de toda la vida.' },\n      { s: 1, text: 'Por sus pupitres pasaron dos alumnos que, años después, cruzarían sus caminos… y cambiarían la medicina.' },\n      { s: 2, text: 'Alumno número uno del Goya: Víctor Fairén Gallán. Doctor en 1915, con premio extraordinario.' },\n      { s: 2, text: 'Se formó en Berna, Zúrich, Basilea, París y Viena. De quirófano en quirófano.' },\n      { s: 2, text: 'En 1918, primer catedrático de Otorrinolaringología de Zaragoza. Y fundador de la Sociedad Española de la especialidad.' },\n      { s: 3, text: 'En Viena conoció a Robert Bárány, Premio Nobel de Medicina en 1914.' },\n      { s: 3, text: 'Descubrió el aparato vestibular: el GPS del equilibrio de tu oído. Sí: lo que te marea en la noria.' },\n      { s: 3, text: 'Fairén insistió… e insistió. Y en diciembre de 1923, ¡el Nobel vino a Zaragoza!' },\n      { s: 4, text: 'Y en primera fila, un chaval de 21 años, discípulo de Ramón y Cajal: Rafael Lorente de Nó. ¡Otro alumno del Goya!', say: 'Y en primera fila, un chaval de veintiún años, discípulo de Ramón y Cajal: Rafael Lorente de Nó. ¡Otro alumno del Goya!' },\n      { s: 4, text: '¿Qué hace un Nobel en su tiempo libre? ¿El Pilar? ¿Tapas por el Tubo? No: debatir de neuronas con el chaval.' },\n      { s: 5, text: 'Bárány lo fichó para su laboratorio en Upsala, Suecia. Y Cajal dio su bendición.' },\n      { s: 5, text: 'De 1924 a 1927 investigó allí el oído y el equilibrio.' },\n      { s: 6, text: 'Y entonces, el bombazo: los circuitos recurrentes. Neuronas que se pasan la señal en bucle.' },\n      { s: 6, text: 'Una idea clave para la cibernética de Norbert Wiener… y para las redes neuronales de la inteligencia artificial.' },\n      { s: 6, text: 'Imaginó la corteza en columnas antes del Nobel de Hubel y Wiesel. Midió el retraso sináptico y sintetizó el TEA.', say: 'Imaginó la corteza en columnas antes del Nobel de Hubel y Wiesel. Midió el retraso sináptico y sintetizó el te, e, a.' },\n      { s: 7, text: '¿Y su Nobel? Lo nominaron cuatro veces… o seis, según quién cuente.' },\n      { s: 7, text: '«El discípulo que llamó seis veces a la puerta de Estocolmo». No le abrieron. Pero en 1950 entró en la Academia Nacional de Ciencias de EE. UU.', say: 'El discípulo que llamó seis veces a la puerta de Estocolmo. No le abrieron. Pero en mil novecientos cincuenta entró en la Academia Nacional de Ciencias de Estados Unidos.' },\n      { s: 8, text: 'Dos alumnos del IES Goya. Uno trajo un Nobel a Zaragoza. El otro nos ayudó a entender el cerebro.', say: 'Dos alumnos del Instituto Goya. Uno trajo un Nobel a Zaragoza. El otro nos ayudó a entender el cerebro.' },\n      { s: 8, text: 'Eso es la educación pública: el talento llega lejos, vengas de donde vengas. Y el Goya lo demuestra.' },\n      { s: 8, text: 'El próximo genio puede estar hoy en un pupitre del Goya. ¿Serás tú?' }\n    ];\n    let acc = 0.4;\n    cues.forEach((c) => {\n      const w = c.text.trim().split(/\\s+/).length;\n      c.start = acc;\n      acc += w / 3.3 + 0.55;\n      c.end = acc;\n    });\n    scenes.forEach((sc, i) => {\n      const cs = cues.filter((c) => c.s === i);\n      sc.start = cs[0].start;\n      sc.end = cs[cs.length - 1].end;\n    });\n    scenes[0].start = 0;\n    const flakes = [];\n    for (let k = 0; k < 28; k++) flakes.push({ x: (k * 37) % 100, d: -((k * 1.7) % 7).toFixed(2), s: 3 + (k % 4) * 2 });\n    const bars = [];\n    for (let k = 0; k < 14; k++) bars.push({ h: 60 + ((k * 53) % 90), c: k % 3 === 0 ? '#FFD23F' : '#8C97C2', d: (0.3 + k * 0.08).toFixed(2) });\n    this._d = { scenes, cues, total: acc + 0.8, flakes, bars };\n    return this._d;\n  }\n\n  idxAt(t) {\n    const cs = this.D().cues;\n    for (let i = cs.length - 1; i >= 0; i--) if (t >= cs[i].start) return i;\n    return 0;\n  }\n\n  componentDidMount() {\n    this.timer = setInterval(() => this.tick(), 100);\n    try { if (window.speechSynthesis) window.speechSynthesis.getVoices(); } catch (e) {}\n  }\n\n  componentWillUnmount() {\n    clearInterval(this.timer);\n    this.stopVoice();\n  }\n\n  tick() {\n    if (!this.state.playing) return;\n    const D = this.D();\n    const t = this.state.t;\n    const i = this.idxAt(t);\n    const c = D.cues[i];\n    const nt = t + 0.1;\n    if (this.state.voice && this.speaking && nt >= c.end - 0.05) {\n      this.hold += 0.1;\n      if (this.hold < 10) return;\n    }\n    if (nt >= D.total) {\n      this.setState({ t: D.total - 0.01, playing: false, ended: true });\n      return;\n    }\n    const ni = this.idxAt(nt);\n    if (ni !== i) this.say(ni, this.state.voice);\n    this.setState({ t: nt });\n  }\n\n  stopVoice() {\n    this.tok += 1;\n    this.speaking = false;\n    this.hold = 0;\n    try { if (window.speechSynthesis) window.speechSynthesis.cancel(); } catch (e) {}\n  }\n\n  say(i, voiceOn) {\n    this.stopVoice();\n    if (!voiceOn) return;\n    try {\n      const S = window.speechSynthesis;\n      if (!S || typeof SpeechSynthesisUtterance === 'undefined') return;\n      const c = this.D().cues[i];\n      const u = new SpeechSynthesisUtterance(c.say || c.text);\n      u.lang = 'es-ES';\n      const vs = S.getVoices() || [];\n      const v = vs.find((x) => x.lang === 'es-ES' && /google|monica|lucia|elvira|alvaro/i.test(x.name)) || vs.find((x) => x.lang === 'es-ES') || vs.find((x) => /^es/i.test(x.lang));\n      if (v) u.voice = v;\n      u.rate = this.props.rate ?? 1.12;\n      u.pitch = 1.02;\n      const tok = this.tok;\n      u.onend = () => { if (tok === this.tok) this.speaking = false; };\n      u.onerror = u.onend;\n      this.speaking = true;\n      S.speak(u);\n    } catch (e) {\n      this.speaking = false;\n    }\n  }\n\n  togglePlay() {\n    const D = this.D();\n    if (!this.state.started || this.state.ended) { this.goScene(0); return; }\n    if (this.state.playing) {\n      this.stopVoice();\n      this.setState({ playing: false });\n    } else {\n      const i = this.idxAt(this.state.t);\n      this.setState({ playing: true, t: D.cues[i].start });\n      this.say(i, this.state.voice);\n    }\n  }\n\n  goScene(k) {\n    const D = this.D();\n    const t = D.scenes[k].start;\n    const i = this.idxAt(t + 0.01);\n    this.setState({ started: true, playing: true, ended: false, t: k === 0 ? 0 : t });\n    this.say(i, this.state.voice);\n  }\n\n  renderVals() {\n    const D = this.D();\n    const { t, playing, started, voice, subs } = this.state;\n    const i = this.idxAt(t);\n    const cue = D.cues[i];\n    const si = cue.s;\n    const on = {}, is = {}, sc = {};\n    D.cues.forEach((c, k) => { on['c' + k] = k <= i; is['c' + k] = k === i; });\n    D.scenes.forEach((s, k) => { sc['s' + (k + 1)] = k === si; });\n    const local = t - D.scenes[si].start;\n    const cl = t - cue.start;\n    const knocks = Math.max(1, Math.min(6, Math.floor(local / 0.7) + 1));\n    const days = Math.max(0, Math.min(10, Math.floor((cl - 2.2) / 0.35)));\n    const fmt = (s) => { s = Math.max(0, Math.floor(s)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };\n    const accent = this.props.accent ?? '#FF5A3C';\n    return {\n      accent,\n      started, playing, notPlaying: !playing, notStarted: !started,\n      voice, subs,\n      showSubs: started && subs,\n      pausedCls: started && !playing ? 'paused' : '',\n      sc, on, is,\n      subtitle: cue.text,\n      chapterLabel: (si + 1) + '/9 · ' + D.scenes[si].name,\n      timeLabel: fmt(t) + ' / ' + fmt(D.total),\n      playLabel: playing ? 'Pausar' : 'Reproducir',\n      voiceCls: voice ? 'on' : '',\n      subsCls: subs ? 'on' : '',\n      flakes: D.flakes,\n      bars: D.bars,\n      knocks,\n      knockCls: knocks < 6 && si === 7 && i === 17 ? 'knock' : '',\n      knockList: Array.from({ length: knocks }, (_, j) => ({ r: (j % 2 ? 6 : -6) })),\n      calDays: Array.from({ length: 10 }, (_, j) => ({ n: j + 1, bg: j < days ? '#FFD23F' : 'transparent', fg: j < days ? '#0A0F22' : '#FFD23F' })),\n      chapters: D.scenes.map((s, k) => ({\n        name: s.name,\n        label: 'Ir al capítulo ' + (k + 1) + ': ' + s.name,\n        grow: (s.end - s.start).toFixed(2),\n        fill: Math.max(0, Math.min(100, ((t - s.start) / (s.end - s.start)) * 100)).toFixed(1),\n        go: () => this.goScene(k)\n      })),\n      togglePlay: () => this.togglePlay(),\n      restart: () => this.goScene(0),\n      toggleVoice: () => {\n        const v = !this.state.voice;\n        this.setState({ voice: v });\n        if (!v) this.stopVoice();\n        else if (this.state.playing) this.say(this.idxAt(this.state.t), true);\n      },\n      toggleSubs: () => this.setState({ subs: !this.state.subs })\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
